{
  "schema": 1,
  "tracks": [
    "SWE",
    "Platform"
  ],
  "search_area": {
    "places": [
      "Melbourne",
      "Australia"
    ],
    "remote": "in-places"
  },
  "search_rules": {
    "max_posting_age_days": 45,
    "expiry_warning_days": 5,
    "ambiguous_age_labels": {
      "1mo ago": "keep",
      "30+ days ago": "discard"
    },
    "max_applicants": {
      "linkedin": 150
    },
    "max_contract_months": 12
  },
  "sources": [
    {
      "name": "greenhouse",
      "type": "api",
      "platform": "greenhouse",
      "targets": [
        "example-board"
      ],
      "access": "works"
    },
    {
      "name": "linkedin",
      "type": "browser",
      "url": "https://www.linkedin.com/jobs/search/?keywords=software%20engineer",
      "access": "login wall",
      "age_format": "2 weeks ago",
      "applicants_format": "Over 100 applicants"
    },
    {
      "name": "seek",
      "type": "manual",
      "url": "https://www.seek.com.au/software-engineer-jobs/in-Melbourne-VIC",
      "notes": "Check the Melbourne results by hand each week"
    }
  ],
  "blockers": [
    [
      "australian citizens?(hip)?",
      "requires Australian citizenship"
    ],
    [
      "baseline clearance|security clearance",
      "requires an AU security clearance"
    ]
  ],
  "letterWordCap": 350,
  "letterWordMin": 150,
  "keySkillsMin": 8,
  "keySkillsMax": 12
}
